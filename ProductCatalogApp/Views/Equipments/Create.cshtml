@model ProductCatalogApp.Models.Equipment

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Equipment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="InventoryNumber" class="control-label"></label>
                <input asp-for="InventoryNumber" class="form-control" />
                <span asp-validation-for="InventoryNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProductionSiteId" class="control-label">
                    Производственная площадка
                </label>

                <select asp-for="ProductionSiteId"
                        class="form-control"
                        asp-items="ViewBag.ProductionSiteId">
                    <option value="">-- Выберите площадку --</option>
                </select>

                <span asp-validation-for="ProductionSiteId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProductionSite" class="control-label"></label>
                <input asp-for="ProductionSite" class="form-control" />
                <span asp-validation-for="ProductionSite" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
