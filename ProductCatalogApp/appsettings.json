{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=production.db",
    "ApplicationDbContext": "Data Source=ApplicationDbContext.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Monitoring": {
    "SimulationEnabled": true,
    "SimulationIntervalSeconds": 5,
    "AlarmProbability": 0.01
  },
  "AllowedHosts": "*"
}